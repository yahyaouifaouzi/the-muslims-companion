# Release signing for Google Play. Copy to android/key.properties (gitignored)
# and fill in your own values. Never commit the real file or the keystore.
#
# Generate a keystore with:
#   keytool -genkey -v -keystore ~/upload-keystore.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
storeFile=/home/YOU/upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
